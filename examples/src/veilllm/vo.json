 ],
 "sentences": [
  {
   "beat": 1,
   "text": "إزاي تستخدم أقوى موديلات الـ cloud، من غير ما داتا عملائك تخرج من جهازك؟",
   "start": 0.3,
   "end": 4.04
  },
  {
   "beat": 1,
   "text": "استنى للآخر، هوريك بالظبط إيه اللي بيوصل للموديل.",
   "start": 4.8,
   "end": 7.464
  },
  {
   "beat": 2,
   "text": "من كام أسبوع كنت بتناقش مع صحابي عن الـ AI harness بتاع كل واحد فينا.",
   "start": 7.914,
   "end": 11.554
  },
  {
   "beat": 2,
   "text": "كلهم عايزين local LLM عشان الداتا الحساسة متتسرّبش.",
   "start": 11.954,
   "end": 15.054
  },
  {
   "beat": 2,
   "text": "بس الـ local models مش قادرة زي موديلات الـ cloud.",
   "start": 15.374,
   "end": 17.859
  },
  {
   "beat": 3,
   "text": "فعملت VeilLLM، proxy لوكال بيقف بين الـ harness بتاعك والموديل.",
   "start": 18.309,
   "end": 26.564
  },
  {
   "beat": 4,
   "text": "بيلاقي الأسامي والإيميلات والـ API keys، ويبدّلها بـ placeholders قبل ما الـ request يخرج.",
   "start": 27.014,
   "end": 33.094
  },
  {
   "beat": 4,
   "text": "ولما الـ response يرجع، بيرجّع القيم الحقيقية مكانها.",
   "start": 33.974,
   "end": 37.543
  },
  {
   "beat": 5,
   "text": "طب بجد بيشتغل؟",
   "start": 37.993,
   "end": 38.953
  },
  {
   "beat": 5,
   "text": "ده اللي انت كتبته.",
   "start": 39.753,
   "end": 40.873
  },
  {
   "beat": 5,
   "text": "وده اللي الموديل شافه.",
   "start": 41.693,
   "end": 43.073
  },
  {
   "beat": 6,
   "text": "وكل ده بيزوّد من 20 لـ 50 millisecond بس على الـ request.",
   "start": 43.523,
   "end": 47.96
  },
  {
   "beat": 7,
   "text": "وانت؟ تثق في موديلات الـ cloud بداتا عملائك، ولا local بس حتى لو أضعف؟",
   "start": 48.41,
   "end": 52.91
  },
  {
   "beat": 7,
   "text": "قولي في الكومنتات.",
   "start": 53.57,
   "end": 54.336
  },
  {
   "beat": 8,
   "text": "الـ repo open source، دوّر على VeilLLM على GitHub.",
   "start": 54.786,
   "end": 57.826
  },
  {
   "beat": 8,
   "text": "ولو عايز حاجات زي دي، اشترك.",
   "start": 57.926,
   "end": 59.69
  }
 ]
}