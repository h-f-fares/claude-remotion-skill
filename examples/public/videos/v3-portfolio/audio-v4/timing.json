 ],
 "sentences": [
  {
   "beat": 1,
   "text": "لو عندك موقع أو مدونة، وسمعت إن الـ AI بقى يقدر يطور مواقع.",
   "start": 0.3,
   "end": 4.5
  },
  {
   "beat": 1,
   "text": "الفيديو ده هيوريك ده بيحصل إزاي، من غير تعقيد.",
   "start": 4.8,
   "end": 7.52
  },
  {
   "beat": 1,
   "text": "من تجربتي على موقعي أنا.",
   "start": 7.82,
   "end": 9.346
  },
  {
   "beat": 2,
   "text": "دي مدونتي.",
   "start": 9.796,
   "end": 10.556
  },
  {
   "beat": 2,
   "text": "أول مرة بنيتها بأداة AI في تلات أيام.",
   "start": 11.076,
   "end": 13.556
  },
  {
   "beat": 2,
   "text": "والمرة التانية خدت بعد ضهر واحد.",
   "start": 13.996,
   "end": 16.002
  },
  {
   "beat": 3,
   "text": "المرة دي كان عندي سؤال واحد:",
   "start": 16.452,
   "end": 18.012
  },
  {
   "beat": 3,
   "text": "أقدر أطور الموقع كله من الموبايل؟",
   "start": 18.412,
   "end": 20.552
  },
  {
   "beat": 3,
   "text": "من غير ما أفتح اللابتوب خالص؟",
   "start": 20.912,
   "end": 22.348
  },
  {
   "beat": 4,
   "text": "الأداة اللي استخدمتها اسمها Claude Code.",
   "start": 22.798,
   "end": 25.398
  },
  {
   "beat": 4,
   "text": "تخيلها مبرمج مساعد، بتكلمه بالكلام العادي، وهو اللي يكتب الكود.",
   "start": 25.838,
   "end": 30.158
  },
  {
   "beat": 4,
   "text": "يعني انت بتوصف اللي عايزه، وهو ينفذ ويوريك النتيجة.",
   "start": 30.698,
   "end": 33.998
  },
  {
   "beat": 4,
   "text": "والجديد إنه بقى شغال أونلاين، فتقدر تكلمه من تطبيق Claude على الموبايل.",
   "start": 34.478,
   "end": 39.229
  },
  {
   "beat": 5,
   "text": "وده اللي عملته، في خمس خطوات بسيطة.",
   "start": 39.679,
   "end": 41.987
  },
  {
   "beat": 6,
   "text": "أولًا، عرّفه على المشروع.",
   "start": 42.437,
   "end": 44.197
  },
  {
   "beat": 6,
   "text": "زي ما بتشرح لزميل جديد الشغل ماشي إزاي، فيه ملف بتكتب فيه الشرح ده مرة واحدة: الموقع معمول إزاي، وبيتبني إزاي، وإيه القواعد.",
   "start": 44.657,
   "end": 54.297
  },
  {
   "beat": 6,
   "text": "وهو بيقراه كل مرة قبل ما يبدأ، فمش محتاج تعيد الشرح.",
   "start": 54.777,
   "end": 58.258
  },
  {
   "beat": 7,
   "text": "تانيًا، ادي كل مهمة لوحدها.",
   "start": 58.708,
   "end": 60.828
  },
  {
   "beat": 7,
   "text": "بدل ما تقوله حسّن الموقع، قوله: صغّر الصور، أو نضّف الكود، أو غيّر الشكل.",
   "start": 61.208,
   "end": 65.588
  },
  {
   "beat": 7,
   "text": "أنا قسمت الشغل على خمس مهام، وكام واحدة منهم اشتغلوا في نفس الوقت.",
   "start": 65.888,
   "end": 71.405
  },
  {
   "beat": 8,
   "text": "تالتًا، سيبه يشتغل.",
   "start": 71.855,
   "end": 73.435
  },
  {
   "beat": 8,
   "text": "الشغل بيكمل على أجهزة Anthropic، الشركة اللي عاملة Claude، حتى لو قفلت الموبايل.",
   "start": 73.715,
   "end": 78.495
  },
  {
   "beat": 8,
   "text": "أنا قضيت حوالي ساعتين على فترات، وهو كمّل الباقي.",
   "start": 78.955,
   "end": 82.161
  },
  {
   "beat": 9,
   "text": "رابعًا، اطلب اختيارات قبل التنفيذ.",
   "start": 82.611,
   "end": 85.331
  },
  {
   "beat": 9,
   "text": "طلبت منه تلات أشكال مختلفة للموقع، شفتهم على الموبايل، واخترت واحد.",
   "start": 85.791,
   "end": 90.591
  },
  {
   "beat": 9,
   "text": "وبعدها بس طبّقه على كل الصفحات.",
   "start": 90.951,
   "end": 93.427
  },
  {
   "beat": 10,
   "text": "وده الشكل اللي اخترته.",
   "start": 93.877,
   "end": 95.037
  },
  {
   "beat": 10,
   "text": "صورة لكل مقال، بالعربي والإنجليزي، وفيه وضع غامق كمان.",
   "start": 95.477,
   "end": 99.851
  },
  {
   "beat": 11,
   "text": "خامسًا، شوف بعينك قبل ما توافق.",
   "start": 100.301,
   "end": 102.621
  },
  {
   "beat": 11,
   "text": "كل تغيير بيطلعله لينك فيه نسخة تجريبية من الموقع.",
   "start": 103.201,
   "end": 106.541
  },
  {
   "beat": 11,
   "text": "بفتحه على الموبايل، ولو عاجبني بوافق.",
   "start": 107.061,
   "end": 109.877
  },
  {
   "beat": 12,
   "text": "والنتيجة؟",
   "start": 110.327,
   "end": 110.927
  },
  {
   "beat": 12,
   "text": "الموقع بقى أسرع بشكل واضح في اختبار جوجل للسرعة.",
   "start": 111.087,
   "end": 114.287
  },
  {
   "beat": 12,
   "text": "والصفحة الرئيسية بقت تظهر في نص الوقت تقريبًا.",
   "start": 114.467,
   "end": 117.527
  },
  {
   "beat": 12,
   "text": "وصور المدونة بقت أخف أكتر من عشر مرات.",
   "start": 117.667,
   "end": 120.655
  },
  {
   "beat": 13,
   "text": "بس فيه حاجة لازم أكون صريح فيها.",
   "start": 121.105,
   "end": 123.205
  },
  {
   "beat": 13,
   "text": "أنا ما قريتش الكود بنفسي.",
   "start": 123.645,
   "end": 125.165
  },
  {
   "beat": 13,
   "text": "خليت أداة تانية تراجعه، ولقت مشاكل اتصلحت قبل ما تنزل. ودي مخاطرة، والقرار في الآخر عليك.",
   "start": 125.605,
   "end": 132.319
  },
  {
   "beat": 14,
   "text": "والتكلفة؟",
   "start": 132.769,
   "end": 133.369
  },
  {
   "beat": 14,
   "text": "كل ده كان على الاشتراك العادي بتاع Claude.",
   "start": 133.769,
   "end": 135.882
  },
  {
   "beat": 15,
   "text": "لو عايز التفاصيل التقنية، الملفات وطريقة المراجعة والقياس،",
   "start": 136.332,
   "end": 139.932
  },
  {
   "beat": 15,
   "text": "كلها خطوة بخطوة في المقال، واللينك في الوصف.",
   "start": 140.192,
   "end": 142.97
  },
  {
   "beat": 16,
   "text": "ولو جربت، قولي في الكومنتات:",
   "start": 143.42,
   "end": 145.38
  },
  {
   "beat": 16,
   "text": "إيه أول حاجة نفسك تطورها في موقعك؟",
   "start": 145.7,
   "end": 148.027
  }
 ],
