 "sentences": [
  {
   "beat": 1,
   "text": "طوّرت مدونتي لتالت مرة، وما احتجتش اللابتوب حتى.",
   "start": 0.3,
   "end": 3.82
  },
  {
   "beat": 1,
   "text": "تعالى نشوف إزاي تقدر تطور موقعك دلوقتي، بالموبايل بس.",
   "start": 4.34,
   "end": 8.121
  },
  {
   "beat": 2,
   "text": "أول مرة بنيتها بأداة AI، وخدت مني تلات أيام.",
   "start": 8.571,
   "end": 12.571
  },
  {
   "beat": 2,
   "text": "والمرة التانية خلصت في بعد ضهر واحد.",
   "start": 13.331,
   "end": 16.073
  },
  {
   "beat": 3,
   "text": "المرة دي كان عندي سؤال واحد:",
   "start": 16.523,
   "end": 18.423
  },
  {
   "beat": 3,
   "text": "أقدر أطور الموقع كله من الموبايل؟",
   "start": 19.243,
   "end": 21.223
  },
  {
   "beat": 3,
   "text": "من غير ما أفتح اللابتوب خالص؟",
   "start": 21.683,
   "end": 23.319
  },
  {
   "beat": 4,
   "text": "الأداة اللي استخدمتها اسمها Claude Code.",
   "start": 23.769,
   "end": 26.289
  },
  {
   "beat": 4,
   "text": "تخيلها مبرمج مساعد، بتكلمه بالكلام العادي، وهو اللي يكتب الكود.",
   "start": 26.709,
   "end": 30.909
  },
  {
   "beat": 4,
   "text": "يعني انت بتوصف اللي عايزه، وهو ينفذ ويوريك النتيجة.",
   "start": 31.349,
   "end": 34.449
  },
  {
   "beat": 4,
   "text": "والجديد إنه بقى شغال أونلاين، فتقدر تكلمه من تطبيق Claude على الموبايل.",
   "start": 34.949,
   "end": 39.352
  },
  {
   "beat": 5,
   "text": "وده اللي عملته، في خمس خطوات بسيطة.",
   "start": 39.802,
   "end": 42.086
  },
  {
   "beat": 6,
   "text": "أولًا، عرّفه على المشروع.",
   "start": 42.536,
   "end": 44.356
  },
  {
   "beat": 6,
   "text": "زي ما بتشرح لزميل جديد الشغل ماشي إزاي، فيه ملف بتكتب فيه الشرح ده مرة واحدة: الموقع معمول إزاي، وبيتبني إزاي، وإيه القواعد.",
   "start": 44.836,
   "end": 53.656
  },
  {
   "beat": 6,
   "text": "وهو بيقراه كل مرة قبل ما يبدأ، فمش محتاج تعيد الشرح.",
   "start": 54.116,
   "end": 57.535
  },
  {
   "beat": 7,
   "text": "تانيًا، ادي كل مهمة لوحدها.",
   "start": 57.985,
   "end": 60.305
  },
  {
   "beat": 7,
   "text": "بدل ما تقوله حسّن الموقع، قوله: صغّر الصور، أو نضّف الكود، أو غيّر الشكل.",
   "start": 60.685,
   "end": 65.905
  },
  {
   "beat": 7,
   "text": "أنا قسمت الشغل على خمس مهام، وكام واحدة منهم اشتغلوا في نفس الوقت.",
   "start": 66.405,
   "end": 70.279
  },
  {
   "beat": 8,
   "text": "تالتًا، سيبه يشتغل.",
   "start": 70.729,
   "end": 72.069
  },
  {
   "beat": 8,
   "text": "الشغل بيكمل على أجهزة Anthropic، الشركة اللي عاملة Claude، حتى لو قفلت الموبايل.",
   "start": 72.549,
   "end": 77.329
  },
  {
   "beat": 8,
   "text": "أنا قضيت حوالي ساعتين على فترات، وهو كمّل الباقي.",
   "start": 77.869,
   "end": 80.716
  },
  {
   "beat": 9,
   "text": "رابعًا، اطلب اختيارات قبل التنفيذ.",
   "start": 81.166,
   "end": 84.266
  },
  {
   "beat": 9,
   "text": "طلبت منه تلات أشكال مختلفة للموقع، شفتهم على الموبايل، واخترت واحد.",
   "start": 84.766,
   "end": 89.946
  },
  {
   "beat": 9,
   "text": "وبعدها بس طبّقه على كل الصفحات.",
   "start": 90.286,
   "end": 92.947
  },
  {
   "beat": 10,
   "text": "وده الشكل اللي اخترته.",
   "start": 93.397,
   "end": 94.737
  },
  {
   "beat": 10,
   "text": "صورة لكل مقال، بالعربي والإنجليزي، وفيه وضع غامق كمان.",
   "start": 95.037,
   "end": 99.779
  },
  {
   "beat": 11,
   "text": "خامسًا، شوف بعينك قبل ما توافق.",
   "start": 100.229,
   "end": 102.689
  },
  {
   "beat": 11,
   "text": "كل تغيير بيطلعله لينك فيه نسخة تجريبية من الموقع.",
   "start": 103.089,
   "end": 106.029
  },
  {
   "beat": 11,
   "text": "بفتحه على الموبايل، ولو عاجبني بوافق.",
   "start": 106.249,
   "end": 108.484
  },
  {
   "beat": 12,
   "text": "كلام حلو… بس الموقع اتحسن فعلًا؟",
   "start": 108.934,
   "end": 111.854
  },
  {
   "beat": 12,
   "text": "آه، بقى أسرع بشكل واضح في اختبار جوجل للسرعة.",
   "start": 112.434,
   "end": 116.314
  },
  {
   "beat": 12,
   "text": "والصفحة الرئيسية بقت تظهر في نص الوقت تقريبًا.",
   "start": 116.894,
   "end": 120.154
  },
  {
   "beat": 12,
   "text": "وصور المدونة بقت أخف أكتر من عشر مرات.",
   "start": 120.754,
   "end": 123.939
  },
  {
   "beat": 13,
   "text": "بس فيه حاجة لازم أكون صريح فيها.",
   "start": 124.389,
   "end": 126.749
  },
  {
   "beat": 13,
   "text": "أنا ما قريتش الكود بنفسي.",
   "start": 127.449,
   "end": 128.869
  },
  {
   "beat": 13,
   "text": "خليت أداة تانية تراجعه، ولقت مشاكل اتصلحت قبل ما تنزل. ودي مخاطرة، والقرار في الآخر عليك.",
   "start": 129.489,
   "end": 136.922
  },
  {
   "beat": 14,
   "text": "والتكلفة؟",
   "start": 137.372,
   "end": 138.032
  },
  {
   "beat": 14,
   "text": "كل ده كان على الاشتراك العادي بتاع Claude.",
   "start": 138.812,
   "end": 141.221
  },
  {
   "beat": 15,
   "text": "الخطوات التقنية كلها في المقال: الملفات، وطريقة المراجعة، والقياس.",
   "start": 141.671,
   "end": 146.971
  },
  {
   "beat": 15,
   "text": "واللينك في الوصف.",
   "start": 147.391,
   "end": 148.24
  },
  {
   "beat": 16,
   "text": "وانت؟",
   "start": 148.69,
   "end": 149.05
  },
  {
   "beat": 16,
   "text": "شايف إن مراجعة الكود سطر سطر مفيش مفر منها؟",
   "start": 149.35,
   "end": 152.27
  },
  {
   "beat": 16,
   "text": "ولا لازم تبقى سريع، وتقبل إنك مش هتراجع كل حاجة، وتسيب الـ AI يراجع؟",
   "start": 152.43,
   "end": 156.63
  },
  {
   "beat": 16,
   "text": "قولي في الكومنتات.",
   "start": 157.169,
   "end": 158.037
  },
  {
   "beat": 17,
   "text": "ولو عايز تشوف التجربة الجاية، اشترك في القناة.",
   "start": 158.487,
   "end": 161.011
  }
 ],
