 "sentences": [
  {
   "beat": 1,
   "text": "هذا الرجل طلب برغر.",
   "start": 0.3,
   "end": 1.926
  },
  {
   "beat": 1,
   "text": "وما وصله... كان سنجابا.",
   "start": 2.176,
   "end": 3.975
  },
  {
   "beat": 1,
   "text": "والأغرب، أن هذه القصة تدرس اليوم لفرق البرمجة حول العالم.",
   "start": 4.225,
   "end": 9.088
  },
  {
   "beat": 2,
   "text": "إليك ما حدث.",
   "start": 9.588,
   "end": 10.489
  },
  {
   "beat": 2,
   "text": "هذا راي.",
   "start": 10.739,
   "end": 11.292
  },
  {
   "beat": 2,
   "text": "الوقت متأخر ليلا، وراي وحيد في المطعم، يمسح الطاولة، وعلى وشك أن يغلق.",
   "start": 11.542,
   "end": 16.7
  },
  {
   "beat": 3,
   "text": "وفجأة يصر الباب ويفتح.",
   "start": 17.2,
   "end": 18.929
  },
  {
   "beat": 3,
   "text": "زبون أخير.",
   "start": 19.179,
   "end": 20.153
  },
  {
   "beat": 3,
   "text": "رجل عجوز طيب، كل ما يريده برغر ساخن.",
   "start": 20.403,
   "end": 23.878
  },
  {
   "beat": 4,
   "text": "يفتح راي الثلاجة... لا يوجد لحم مفروم.",
   "start": 24.378,
   "end": 27.167
  },
  {
   "beat": 4,
   "text": "ليس قليلا.",
   "start": 27.417,
   "end": 28.502
  },
  {
   "beat": 4,
   "text": "نفد.",
   "start": 28.752,
   "end": 29.131
  },
  {
   "beat": 5,
   "text": "وتذكر راي قاعدة مديره الوحيدة: لا ترد زبونا أبدا.",
   "start": 29.631,
   "end": 34.003
  },
  {
   "beat": 5,
   "text": "أبدا. فقرر راي أن... يتصرف.",
   "start": 34.253,
   "end": 36.605
  },
  {
   "beat": 6,
   "text": "في وقت سابق من ذلك اليوم، رأى شيئا خلف المطعم.",
   "start": 37.105,
   "end": 40.513
  },
  {
   "beat": 6,
   "text": "سنجابا ميتا، ملقى بجانب صندوق القمامة.",
   "start": 40.763,
   "end": 43.819
  },
  {
   "beat": 7,
   "text": "فسلخه.",
   "start": 44.319,
   "end": 44.816
  },
  {
   "beat": 7,
   "text": "وفرمه.",
   "start": 45.066,
   "end": 45.605
  },
  {
   "beat": 7,
   "text": "وشواه.",
   "start": 45.855,
   "end": 46.466
  },
  {
   "beat": 7,
   "text": "وقدمه للرجل العجوز، الذي أخذ أكبر قضمة في حياته.",
   "start": 46.716,
   "end": 51.152
  },
  {
   "beat": 8,
   "text": "بعد ثلاث ساعات؟",
   "start": 51.652,
   "end": 53.179
  },
  {
   "beat": 8,
   "text": "الرجل العجوز في المستشفى.",
   "start": 53.429,
   "end": 55.341
  },
  {
   "beat": 9,
   "text": "وفي صباح اليوم التالي، العنوان في الصحف ليس راي، بل اسم المطعم على اللافتة.",
   "start": 55.841,
   "end": 61.047
  },
  {
   "beat": 9,
   "text": "والعلامة التجارية كلها تدفع الثمن.",
   "start": 61.297,
   "end": 63.733
  },
  {
   "beat": 10,
   "text": "لكن، هل حدث هذا فعلا؟",
   "start": 64.233,
   "end": 65.969
  },
  {
   "beat": 10,
   "text": "القصة تعود إلى كين شوابر، أحد مؤسسي سكرم.",
   "start": 66.219,
   "end": 69.666
  },
  {
   "beat": 10,
   "text": "في عام ألفين وخمسة عشر، سأله أحدهم: هل هي حقيقية؟",
   "start": 69.916,
   "end": 74.195
  },
  {
   "beat": 10,
   "text": "وكان رده؟",
   "start": 74.445,
   "end": 75.384
  },
  {
   "beat": 10,
   "text": "إنها أسطورة. لكن الناس ما زالوا يروونها... لأن كل فريق قدم سنجابا من قبل.",
   "start": 75.634,
   "end": 81.188
  },
  {
   "beat": 11,
   "text": "فكر في الأمر.",
   "start": 81.688,
   "end": 82.451
  },
  {
   "beat": 11,
   "text": "موعد نهائي لا يتحرك.",
   "start": 82.701,
   "end": 84.562
  },
  {
   "beat": 11,
   "text": "عمل لا يتسع له الوقت.",
   "start": 84.812,
   "end": 86.597
  },
  {
   "beat": 11,
   "text": "ولا أحد يجرؤ أن يقول لا.",
   "start": 86.847,
   "end": 88.948
  },
  {
   "beat": 11,
   "text": "فيقص أحدهم من الجودة بهدوء.",
   "start": 89.198,
   "end": 91.359
  },
  {
   "beat": 11,
   "text": "يتخطى الاختبارات.",
   "start": 91.609,
   "end": 93.002
  },
  {
   "beat": 11,
   "text": "يطلق الخطأ.",
   "start": 93.252,
   "end": 94.213
  },
  {
   "beat": 11,
   "text": "ويتمنى ألا يلاحظ أحد.",
   "start": 94.463,
   "end": 96.363
  },
  {
   "beat": 12,
   "text": "لكن هناك دائما من يلاحظ.",
   "start": 96.863,
   "end": 98.767
  },
  {
   "beat": 12,
   "text": "الزبون.",
   "start": 99.017,
   "end": 99.727
  },
  {
   "beat": 12,
   "text": "الفريق.",
   "start": 99.977,
   "end": 100.574
  },
  {
   "beat": 12,
   "text": "والشركة.",
   "start": 100.824,
   "end": 101.531
  },
  {
   "beat": 13,
   "text": "إذن، ماذا كان على راي أن يفعل؟",
   "start": 102.031,
   "end": 104.392
  },
  {
   "beat": 13,
   "text": "ثلاثة أشياء.",
   "start": 104.642,
   "end": 105.5
  },
  {
   "beat": 14,
   "text": "أولا.",
   "start": 106.0,
   "end": 106.375
  },
  {
   "beat": 14,
   "text": "فاوض على حجم العمل، لا على الجودة.",
   "start": 106.625,
   "end": 108.897
  },
  {
   "beat": 14,
   "text": "أصناف أقل في القائمة.",
   "start": 109.147,
   "end": 110.878
  },
  {
   "beat": 14,
   "text": "لكن لا سنجاب في الخبز أبدا.",
   "start": 111.128,
   "end": 113.199
  },
  {
   "beat": 15,
   "text": "ثانيا.",
   "start": 113.699,
   "end": 114.16
  },
  {
   "beat": 15,
   "text": "قدم الأهم أولا.",
   "start": 114.41,
   "end": 115.464
  },
  {
   "beat": 15,
   "text": "طلب صغير من طعام حقيقي، أفضل من صينية كاملة من الكوارث.",
   "start": 115.714,
   "end": 120.155
  },
  {
   "beat": 16,
   "text": "ثالثا.",
   "start": 120.655,
   "end": 121.175
  },
  {
   "beat": 16,
   "text": "تكلم مبكرا.",
   "start": 121.425,
   "end": 122.494
  },
  {
   "beat": 16,
   "text": "في اللحظة التي بدأ فيها اللحم يقل، كان ذلك وقت الكلام.",
   "start": 122.744,
   "end": 126.72
  },
  {
   "beat": 16,
   "text": "ليس في منتصف الليل.",
   "start": 126.97,
   "end": 128.531
  },
  {
   "beat": 17,
   "text": "لأنه عندما ينفد الوقت، يمكنك تقليص القائمة.",
   "start": 129.031,
   "end": 132.429
  },
  {
   "beat": 17,
   "text": "لكن إياك... أن تقدم السنجاب.",
   "start": 132.679,
   "end": 134.894
  }
 ],
