 "sentences": [
  {
   "beat": 1,
   "text": "الراجل ده طلب برجر.",
   "start": 0.3,
   "end": 1.76
  },
  {
   "beat": 1,
   "text": "واللي جاله... كان سنجاب.",
   "start": 2.1,
   "end": 3.74
  },
  {
   "beat": 1,
   "text": "والغريب بقى، إن الحكاية دي بتتدرّس لفرق البرمجة في العالم كله.",
   "start": 4.36,
   "end": 8.919
  },
  {
   "beat": 2,
   "text": "خلّيني أحكيلك اللي حصل.",
   "start": 9.369,
   "end": 10.449
  },
  {
   "beat": 2,
   "text": "ده راي.",
   "start": 11.169,
   "end": 11.549
  },
  {
   "beat": 2,
   "text": "الساعة متأخرة، وراي لوحده في المطعم، بيمسح الكاونتر، وخلاص هيقفل.",
   "start": 11.949,
   "end": 16.104
  },
  {
   "beat": 3,
   "text": "وفجأة الباب بيزيّق.",
   "start": 16.554,
   "end": 18.674
  },
  {
   "beat": 3,
   "text": "زبون أخير.",
   "start": 19.314,
   "end": 20.234
  },
  {
   "beat": 3,
   "text": "راجل عجوز طيب، كل اللي نفسه فيه برجر سخن.",
   "start": 21.054,
   "end": 25.143
  },
  {
   "beat": 4,
   "text": "راي بيفتح التلاجة... مفيش لحمة مفرومة.",
   "start": 25.593,
   "end": 28.633
  },
  {
   "beat": 4,
   "text": "مش قليلة.",
   "start": 29.033,
   "end": 29.693
  },
  {
   "beat": 4,
   "text": "خلصانة.",
   "start": 29.813,
   "end": 30.41
  },
  {
   "beat": 5,
   "text": "وراي افتكر قاعدة المدير الوحيدة: عمرك ما ترجّع زبون.",
   "start": 30.86,
   "end": 35.68
  },
  {
   "beat": 5,
   "text": "أبدًا. فراي قرر... يتصرّف.",
   "start": 36.48,
   "end": 38.733
  },
  {
   "beat": 6,
   "text": "الصبح بدري، كان شاف حاجة ورا المطعم.",
   "start": 39.183,
   "end": 41.743
  },
  {
   "beat": 6,
   "text": "سنجاب ميت، مرمي جنب صندوق الزبالة.",
   "start": 42.163,
   "end": 44.42
  },
  {
   "beat": 7,
   "text": "فسلخه.",
   "start": 44.87,
   "end": 45.57
  },
  {
   "beat": 7,
   "text": "وفرمه.",
   "start": 45.93,
   "end": 46.63
  },
  {
   "beat": 7,
   "text": "وشواه.",
   "start": 47.09,
   "end": 47.77
  },
  {
   "beat": 7,
   "text": "وقدّمه للراجل العجوز، اللي خد أكبر قضمة في حياته.",
   "start": 48.33,
   "end": 52.342
  },
  {
   "beat": 8,
   "text": "بعد تلات ساعات؟",
   "start": 52.792,
   "end": 53.732
  },
  {
   "beat": 8,
   "text": "الراجل العجوز في المستشفى.",
   "start": 54.352,
   "end": 55.779
  },
  {
   "beat": 9,
   "text": "وتاني يوم الصبح، العنوان في الجرايد مش راي، العنوان هو اسم المطعم.",
   "start": 56.229,
   "end": 61.529
  },
  {
   "beat": 9,
   "text": "والبراند كله اتضرب.",
   "start": 62.029,
   "end": 63.396
  },
  {
   "beat": 10,
   "text": "طب، هي الحكاية دي حصلت فعلًا؟",
   "start": 63.846,
   "end": 65.786
  },
  {
   "beat": 10,
   "text": "الحكاية جاية من كين شوابر، واحد من اللي عملوا سكرم.",
   "start": 66.486,
   "end": 69.966
  },
  {
   "beat": 10,
   "text": "وفي ألفين وخمستاشر، حد سأله هي حقيقية؟",
   "start": 70.086,
   "end": 73.026
  },
  {
   "beat": 10,
   "text": "ردّه كان إيه؟",
   "start": 73.526,
   "end": 74.186
  },
  {
   "beat": 10,
   "text": "دي أسطورة. بس الناس لسه بتحكيها... علشان كل فريق قدّم سنجاب قبل كده.",
   "start": 74.606,
   "end": 79.5
  },
  {
   "beat": 11,
   "text": "فكّر فيها كده.",
   "start": 79.95,
   "end": 80.81
  },
  {
   "beat": 11,
   "text": "ديدلاين مش بيتحرك.",
   "start": 81.37,
   "end": 82.67
  },
  {
   "beat": 11,
   "text": "شغل مش داخل في الوقت.",
   "start": 83.07,
   "end": 84.45
  },
  {
   "beat": 11,
   "text": "ومحدش عنده الجرأة يقول لأ.",
   "start": 84.95,
   "end": 86.71
  },
  {
   "beat": 11,
   "text": "فحد بيقصّ في الجودة من غير ما حد ياخد باله.",
   "start": 87.43,
   "end": 90.07
  },
  {
   "beat": 11,
   "text": "بيسكّب التيستات.",
   "start": 90.65,
   "end": 91.69
  },
  {
   "beat": 11,
   "text": "بينزّل البج.",
   "start": 92.15,
   "end": 93.05
  },
  {
   "beat": 11,
   "text": "ويدعي إن محدش يلاحظ.",
   "start": 93.49,
   "end": 95.074
  },
  {
   "beat": 12,
   "text": "بس دايمًا في حد بياخد باله.",
   "start": 95.524,
   "end": 97.184
  },
  {
   "beat": 12,
   "text": "الزبون.",
   "start": 97.724,
   "end": 98.464
  },
  {
   "beat": 12,
   "text": "الفريق.",
   "start": 98.904,
   "end": 99.664
  },
  {
   "beat": 12,
   "text": "والبيزنس.",
   "start": 100.264,
   "end": 100.89
  },
  {
   "beat": 13,
   "text": "طب كان المفروض راي يعمل إيه؟",
   "start": 101.34,
   "end": 103.06
  },
  {
   "beat": 13,
   "text": "تلات حاجات.",
   "start": 103.46,
   "end": 104.219
  },
  {
   "beat": 14,
   "text": "واحد.",
   "start": 104.668,
   "end": 105.168
  },
  {
   "beat": 14,
   "text": "فاوض على حجم الشغل، مش على الجودة.",
   "start": 105.448,
   "end": 107.868
  },
  {
   "beat": 14,
   "text": "قلّل الأصناف في المنيو.",
   "start": 108.569,
   "end": 109.828
  },
  {
   "beat": 14,
   "text": "بس عمرك ما تحط سنجاب في العيش.",
   "start": 110.488,
   "end": 112.638
  },
  {
   "beat": 15,
   "text": "اتنين.",
   "start": 113.088,
   "end": 113.568
  },
  {
   "beat": 15,
   "text": "قدّم الأهم الأول.",
   "start": 114.268,
   "end": 115.288
  },
  {
   "beat": 15,
   "text": "طلب صغير من أكل حقيقي، أحسن من صينية كاملة من الكوارث.",
   "start": 115.908,
   "end": 119.927
  },
  {
   "beat": 16,
   "text": "تلاتة.",
   "start": 120.377,
   "end": 120.797
  },
  {
   "beat": 16,
   "text": "اتكلم بدري.",
   "start": 121.417,
   "end": 122.197
  },
  {
   "beat": 16,
   "text": "أول ما اللحمة بدأت تخلص، ده كان وقت الكلام.",
   "start": 122.737,
   "end": 125.437
  },
  {
   "beat": 16,
   "text": "مش الساعة اتناشر بالليل.",
   "start": 125.877,
   "end": 127.104
  },
  {
   "beat": 17,
   "text": "علشان لما الوقت يخلص، ممكن تقلّل المنيو.",
   "start": 127.554,
   "end": 130.414
  },
  {
   "beat": 17,
   "text": "بس عمرك... ما تقدّم السنجاب.",
   "start": 130.714,
   "end": 132.862
  }
 ],
