 "sentences": [
  {
   "beat": "hook",
   "id": "hook1",
   "text": "كل مرة بتكلّم الـ AI، أسامي عملائك وإيميلاتهم بتخرج من جهازك.",
   "start": 0.3,
   "end": 6.346
  },
  {
   "beat": "hook",
   "id": "hook2",
   "text": "استنى للآخر، وهوريك الموديل بيشوف إيه بالظبط.",
   "start": 6.796,
   "end": 10.182
  },
  {
   "beat": "risk",
   "id": "risk1",
   "text": "والمشكلة إنك بتبعت داتا حساسة للموديل من غير ما يكون محتاجها.",
   "start": 10.782,
   "end": 14.569
  },
  {
   "beat": "risk",
   "id": "risk2",
   "text": "وده حصل فعلًا: DeepSeek ساب داتابيز مفتوحة فيها شاتات الناس والـ API keys.",
   "start": 15.069,
   "end": 21.693
  },
  {
   "beat": "risk",
   "id": "risk3",
   "text": "وموظفين في Samsung سرّبوا كود سري في ChatGPT.",
   "start": 22.143,
   "end": 25.528
  },
  {
   "beat": "risk",
   "id": "risk4",
   "text": "وفي نفس الوقت، مش عملي إنك كل شوية تشيل الأسامي والـ keys بإيدك قبل ما تبعت.",
   "start": 26.928,
   "end": 31.98
  },
  {
   "beat": "friends",
   "id": "story1",
   "text": "من كام أسبوع كنت بتكلم مع صحابي عن الـ AI harness بتاع كل واحد فينا.",
   "start": 32.58,
   "end": 37.983
  },
  {
   "beat": "friends",
   "id": "story2",
   "text": "كلهم عايزين local LLM عشان الداتا الحساسة.",
   "start": 38.483,
   "end": 42.163
  },
  {
   "beat": "friends",
   "id": "story3",
   "text": "بس الـ local models لسه مش قادرة زي موديلات الـ cloud.",
   "start": 42.663,
   "end": 47.264
  },
  {
   "beat": "reveal",
   "id": "reveal",
   "text": "فعملت VeilLLM، proxy لوكال بيقف بين الـ harness بتاعك والموديل.",
   "start": 47.864,
   "end": 52.837
  },
  {
   "beat": "mask",
   "id": "mask1",
   "text": "بيلاقي الأسامي والإيميلات والـ API keys، ويبدّلها بـ placeholders قبل ما الـ request يخرج.",
   "start": 53.437,
   "end": 59.13
  },
  {
   "beat": "mask",
   "id": "mask2",
   "text": "ولما الرد يرجع، بيرجّع القيم الحقيقية مكانها.",
   "start": 59.63,
   "end": 64.185
  },
  {
   "beat": "reset",
   "id": "reset",
   "text": "طب بجد بيشتغل؟",
   "start": 64.785,
   "end": 66.055
  },
  {
   "beat": "demo",
   "id": "proof1",
   "text": "ده اللي انت كتبته.",
   "start": 66.555,
   "end": 67.507
  },
  {
   "beat": "saw",
   "id": "proof2",
   "text": "وده اللي الموديل شافه.",
   "start": 69.107,
   "end": 70.884
  },
  {
   "beat": "speed",
   "id": "speed",
   "text": "وكل ده بيزوّد من 20 لـ 50 millisecond بس، والتركيب سطر واحد: تغيّر الـ base URL وخلاص.",
   "start": 72.684,
   "end": 77.958
  },
  {
   "beat": "choice",
   "id": "ask1",
   "text": "وانت؟ تثق في موديلات الـ cloud بداتا عملائك، ولا local بس حتى لو أضعف؟",
   "start": 78.558,
   "end": 84.2
  },
  {
   "beat": "choice",
   "id": "ask2",
   "text": "قولي في الكومنتات.",
   "start": 84.65,
   "end": 85.756
  },
  {
   "beat": "cta",
   "id": "cta",
   "text": "الكود open source على GitHub، دوّر على VeilLLM.",
   "start": 86.356,
   "end": 89.543
  }
 ]
}